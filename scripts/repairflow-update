#!/bin/sh
# Check or apply a signed RepairFlow GitHub release. With no tag, use the latest
# stable release. Network access belongs to this optional operator-invoked helper.
set -eu
LC_ALL=C
export LC_ALL

REPO=obionar/repairflow
TAG=
BINARY=${REPAIRFLOW_BIN:-repairflow}
APPLY=0
RESTART=0
BASE=${REPAIRFLOW_UPDATE_BASE_URL:-https://github.com}
WORK=

usage() {
  cat <<'EOF'
Usage: repairflow-update [TAG] [options]

  TAG                 exact release tag, including v and any prerelease suffix
  --tag TAG           same as positional TAG (default: latest stable release)
  --repo OWNER/NAME   source repository (default: obionar/repairflow)
  --binary PATH       installed RepairFlow executable (default: PATH, then ~/.local/bin)
  --apply             replace the binary after verification; default is check-only
  --restart           restart the default systemd/OpenRC service after applying
  -h, --help          show this help

Examples:
  repairflow-update                         verify the latest stable release
  repairflow-update --apply --restart       install it and restart the service
  repairflow-update v0.2.0-rc6 --apply      install an exact prerelease

A backup and stopped writer are still required for schema-changing upgrades.
Automatic doas/sudo requires root-owned, non-writable binary paths and parents.
EOF
}

fail() {
  echo "repairflow-update: $*" >&2
  exit 1
}

usage_error() {
  echo "repairflow-update: $*" >&2
  usage >&2
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --tag)
      [ $# -ge 2 ] || usage_error "--tag requires a value"
      [ -z "$TAG" ] || usage_error "release tag given more than once"
      TAG=$2; shift 2 ;;
    --repo)
      [ $# -ge 2 ] || usage_error "--repo requires a value"
      REPO=$2; shift 2 ;;
    --binary)
      [ $# -ge 2 ] || usage_error "--binary requires a value"
      BINARY=$2; shift 2 ;;
    --apply) APPLY=1; shift ;;
    --restart) RESTART=1; shift ;;
    -h|--help) usage; exit 0 ;;
    v*)
      [ -z "$TAG" ] || usage_error "release tag given more than once"
      TAG=$1; shift ;;
    *) usage_error "unknown argument: $1" ;;
  esac
done
[ "$RESTART" -eq 0 ] || [ "$APPLY" -eq 1 ] || usage_error "--restart requires --apply"

case "$REPO" in
  */*/*) fail "repository must have exactly the form owner/name" ;;
  */*) ;;
  *) fail "repository must have the form owner/name" ;;
esac
case "$REPO" in *[!0-9A-Za-z._/-]*) fail "invalid repository" ;; esac
REPO_OWNER=${REPO%%/*}
REPO_NAME=${REPO#*/}
case "$REPO_OWNER:$REPO_NAME" in
  -*) fail "invalid repository" ;;
  *..*) fail "invalid repository" ;;
esac

case "$BINARY" in
  */*) [ -x "$BINARY" ] || fail "binary is not executable: $BINARY" ;;
  *)
    if command -v "$BINARY" >/dev/null 2>&1; then
      BINARY=$(command -v "$BINARY")
    elif [ -x "$HOME/.local/bin/repairflow" ]; then
      BINARY=$HOME/.local/bin/repairflow
    else
      fail "cannot find repairflow on PATH or in ~/.local/bin"
    fi ;;
esac
BINARY_DIR=$(CDPATH= cd -P -- "$(dirname "$BINARY")" && pwd) || fail "cannot resolve binary directory"
BINARY=$BINARY_DIR/$(basename "$BINARY")
command -v sha256sum >/dev/null 2>&1 || fail "sha256sum is required"
command -v tar >/dev/null 2>&1 || fail "tar is required"
BASE=${BASE%/}

# GitHub's latest redirect excludes prereleases. An exact tag skips this probe,
# works with either downloader, and is required when selecting an RC.
if [ -z "$TAG" ]; then
  command -v curl >/dev/null 2>&1 || fail "curl is required to resolve latest; pass an exact tag to use wget"
  latest=$(curl -fsSI -m 15 "$BASE/$REPO/releases/latest" 2>/dev/null) || fail "cannot resolve latest release"
  TAG=$(printf '%s\n' "$latest" | tr -d '\r' | sed -n 's|^[Ll]ocation: .*/tag/\(v[^ /]*\)$|\1|p')
  [ -n "$TAG" ] || fail "latest release redirect did not contain a tag"
fi
case "$TAG" in
  -*) fail "invalid release tag" ;;
  *..*) fail "invalid release tag" ;;
  *[!0-9A-Za-z._-]*) fail "invalid release tag" ;;
esac

ARCH=$(uname -m)
case "$ARCH" in
  x86_64|amd64) ARCH=amd64; LABEL=x86_64 ;;
  aarch64|arm64) ARCH=arm64; LABEL=arm64 ;;
  *) fail "unsupported architecture: $ARCH" ;;
esac
ASSET=repairflow_Linux_$LABEL.tar.gz
WORK=$(mktemp -d "${TMPDIR:-/tmp}/repairflow-update.XXXXXX")
cleanup() { rm -rf "$WORK"; }
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

download() {
  url=$1
  dest=$2
  echo "repairflow-update: downloading ${url##*/}"
  (
    # 524288 * 512-byte blocks = 256 MiB.
    ulimit -c 0 2>/dev/null || true
    ulimit -f 524288
    if command -v wget >/dev/null 2>&1; then
      wget -q -T 30 -t 2 -O "$dest" "$url"
    elif command -v curl >/dev/null 2>&1; then
      curl -fsSL --connect-timeout 10 --max-time 300 -o "$dest" "$url"
    else
      fail "wget or curl is required"
    fi
  ) || fail "download failed: $url"
  [ -s "$dest" ] || fail "downloaded file is empty: ${url##*/}"
}

RELEASE_URL=$BASE/$REPO/releases/download/$TAG
ARCHIVE=$WORK/$ASSET
download "$RELEASE_URL/$ASSET" "$ARCHIVE"

tar -tzf "$ARCHIVE" > "$WORK/members.txt" || fail "invalid release archive: $ASSET"
for member in repairflow manifest.json manifest.sig; do
  grep -qx -- "$member" "$WORK/members.txt" || fail "release archive is missing $member"
done
if grep -Eq '(^/|(^|/)\.\.(/|$))' "$WORK/members.txt"; then
  fail "release archive contains an unsafe path"
fi
tar -xzf "$ARCHIVE" -C "$WORK" repairflow manifest.json manifest.sig || fail "cannot extract release archive"
for member in repairflow manifest.json manifest.sig; do
  [ -f "$WORK/$member" ] && [ ! -L "$WORK/$member" ] || fail "$member is not a regular file"
done

"$BINARY" update check --manifest "$WORK/manifest.json" --signature "$WORK/manifest.sig"
CHECK_JSON=$("$BINARY" update check --manifest "$WORK/manifest.json" --signature "$WORK/manifest.sig" --json | tr -d '[:space:]')
EXPECTED_HASH=$(printf '%s' "$CHECK_JSON" | sed -n 's/.*"artifact":{[^}]*"sha256":"\([0-9a-f]\{64\}\)".*/\1/p')
EXPECTED_SIZE=$(printf '%s' "$CHECK_JSON" | sed -n 's/.*"artifact":{[^}]*"size_bytes":\([0-9][0-9]*\).*/\1/p')
[ -n "$EXPECTED_HASH" ] && [ -n "$EXPECTED_SIZE" ] || fail "cannot read verified artifact metadata"
HASH=$(sha256sum "$WORK/repairflow" | cut -d' ' -f1)
SIZE=$(wc -c < "$WORK/repairflow" | tr -d '[:space:]')
[ "$HASH" = "$EXPECTED_HASH" ] || fail "artifact hash does not match the signed manifest"
[ "$SIZE" = "$EXPECTED_SIZE" ] || fail "artifact size does not match the signed manifest"
echo "update verified: $TAG (linux/$ARCH)"

require_privileged_binary() {
  command -v stat >/dev/null 2>&1 || fail "stat is required for privileged apply"
  [ -f "$BINARY" ] && [ ! -L "$BINARY" ] || fail "privileged apply requires a regular, non-symlink binary"
  checked=$BINARY
  while :; do
    owner=$(stat -c %u -- "$checked") || fail "cannot inspect ownership: $checked"
    mode=$(stat -c %a -- "$checked") || fail "cannot inspect permissions: $checked"
    [ "$owner" = 0 ] && [ "$((0$mode & 022))" -eq 0 ] || fail "refusing privileged apply: $checked must be root-owned and not group/world-writable"
    [ "$checked" != / ] || break
    checked=$(dirname "$checked")
  done
}

restart_service() {
  if command -v systemctl >/dev/null 2>&1; then
    if systemctl --user restart repairflow.service 2>/dev/null; then
      echo "repairflow-update: systemd service restarted"
      return 0
    fi
    echo "repairflow-update: update applied, but systemd restart failed; inspect repairflow.service" >&2
    return 1
  fi
  for priv in doas sudo; do
    if command -v "$priv" >/dev/null 2>&1 && "$priv" rc-service repairflow restart 2>/dev/null; then
      echo "repairflow-update: OpenRC service restarted"
      return 0
    fi
  done
  echo "repairflow-update: update applied, but restart was not confirmed; run: systemctl --user restart repairflow.service (or doas rc-service repairflow restart)" >&2
  return 1
}

if [ "$APPLY" -eq 1 ]; then
  if [ -w "$(dirname "$BINARY")" ] || [ "$(id -u)" -eq 0 ]; then
    "$BINARY" update apply --file "$WORK/repairflow" --manifest "$WORK/manifest.json" --signature "$WORK/manifest.sig" --confirm
  else
    require_privileged_binary
    if command -v doas >/dev/null 2>&1; then
      priv=doas
    elif command -v sudo >/dev/null 2>&1; then
      priv=sudo
    else
      fail "the installed binary is not writable; rerun with root privileges (doas/sudo)"
    fi
    "$priv" "$BINARY" update apply --file "$WORK/repairflow" --manifest "$WORK/manifest.json" --signature "$WORK/manifest.sig" --confirm
  fi
  if [ "$RESTART" -eq 1 ]; then
    restart_service
  else
    echo "restart the RepairFlow service, then run version and doctor"
  fi
else
  echo "check-only: no installed file was changed; re-run with --apply to install"
fi
"$BINARY" version | head -1
