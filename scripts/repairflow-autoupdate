#!/bin/sh
# repairflow-autoupdate — unattended, fail-closed update of one installed service.
#
# Run it from cron or a systemd timer. Exit 0 means nothing needed doing, or a
# precondition refused the candidate before anything was changed. A non-zero exit
# means a stop, backup, apply or post-restart health check failed; the service is
# then left as cleanup last observed it for a human. This script never renames or
# restores the live workspace, never puts <exe>.prev back automatically and never
# deletes backups: recovery is manual and the log says exactly what was preserved.
#
# The channel is GitHub's "latest", which excludes prereleases by definition, so an
# unattended run never jumps to a release candidate. Set RF_UPDATE_TAG to pin one.
# Only the default service instance is supported: the effective unit's pinned binary
# and --home must match this run, otherwise the script refuses and prints manual steps.
#
# It serializes cooperating invocations only. It cannot detect an external CLI
# writer, so the operator must keep other writers (manual CLI use, other tooling)
# out of the workspace for the duration of an unattended update.
set -eu
home=${REPAIRFLOW_HOME:-$HOME/.repairflow}
# cron has a minimal PATH: resolve the binary once, with the default install dir as fallback.
bin=${REPAIRFLOW_BIN:-$(command -v repairflow || true)}
[ -n "$bin" ] || bin=$HOME/.local/bin/repairflow
[ -x "$bin" ] || { echo "repairflow-autoupdate: repairflow not found (set REPAIRFLOW_BIN)" >&2; exit 1; }
# The fetcher must replace the binary the unit runs, not whichever one it finds.
REPAIRFLOW_BIN=$bin
export REPAIRFLOW_BIN
fetch=$(command -v repairflow-update || true)
[ -n "$fetch" ] || fetch=$HOME/.local/bin/repairflow-update
[ -x "$fetch" ] || { echo "repairflow-autoupdate: repairflow-update not found" >&2; exit 1; }

# Updater state is outside cache/ and run/, which `repairflow cleanup` may remove.
# It holds this run's lock and the failed-tag markers only; it is not backed up,
# migrated or deleted automatically. Destroying the workspace also discards it.
state=$home/.update-state
log=$home/logs/update.log
mkdir -p "$home/logs" 2>/dev/null || {
  echo "repairflow-autoupdate: cannot create $home/logs" >&2; exit 1; }
mkdir -p "$state" 2>/dev/null || {
  echo "repairflow-autoupdate: cannot create $state" >&2; exit 1; }
chmod 700 "$state" 2>/dev/null || {
  echo "repairflow-autoupdate: cannot make $state owner-only" >&2; exit 1; }

# A failed log write must never abort an update or hide a failure: fall back to stderr.
say() {
  line="$(date -Is) $*"
  printf '%s\n' "$line" >>"$log" 2>/dev/null || printf '%s\n' "$line" >&2
}
# A refusal happens before anything changes and keeps the job exit 0.
refuse() { say "refuse: $*"; exit 0; }
# A failure exits non-zero so the scheduler surfaces it; cleanup reports the truth.
fail() { say "abort: $*"; exit 1; }

cand=
bdir=
bkp=
verified_backup=
incomplete_backup=
marker_state=none
svc_touched=0
candidate_applied=0
apply_attempted=0
finished=0

# Record a candidate as failed. A marker error is reported, never hidden behind a
# claim that the tag will not be retried.
mark_failed() {
  [ -n "$cand" ] || return 0
  if (umask 077; : >"$state/failed-$cand") 2>/dev/null; then
    marker_state=ok
  else
    marker_state=failed
    say "warn: cannot write the failed-tag marker $state/failed-$cand"
  fi
}

# One truthful summary for an expected failure, an unexpected error or a signal.
# It never renames/restores anything, never masks the original status, and only
# promises what was actually observed.
cleanup() {
  rc=$?
  trap '' HUP INT TERM
  if [ "$finished" = 1 ]; then exit "$rc"; fi
  if [ "$rc" = 0 ]; then exit 0; fi

  if [ "$apply_attempted" = 1 ]; then mark_failed; fi
  if [ "$candidate_applied" = 1 ]; then
    prior=$(service_state) || prior=unknown
    if [ "$prior" != stopped ]; then
      if svc_log stop; then
        say "cleanup: stopped the $cand candidate"
      else
        say "cleanup: could not stop the $cand candidate; stop it manually"
      fi
    fi
  fi
  if [ "$svc_touched" = 1 ]; then
    observed=$(service_state) || observed=unknown
  else
    observed='not changed'
  fi

  msg="MANUAL RECOVERY:"
  case $observed in
    'not changed') msg="$msg the repairflow service was not changed by this run;";;
    stopped) msg="$msg repairflow is STOPPED;";;
    running) msg="$msg repairflow is RUNNING;";;
    *) msg="$msg the repairflow service state is UNKNOWN;";;
  esac
  if [ "$candidate_applied" = 1 ]; then
    msg="$msg candidate $cand was applied, previous binary: $bin.prev;"
  elif [ "$apply_attempted" = 1 ]; then
    msg="$msg applying $cand failed, so $bin.prev may still be the live binary;"
  else
    msg="$msg no candidate was applied;"
  fi
  case $marker_state in
    ok) msg="$msg $cand is marked failed and will not be retried automatically;";;
    failed) msg="$msg WARNING: could not record $cand as failed in $state, so a later run may retry it - record it manually;";;
  esac
  if [ -n "$verified_backup" ]; then
    msg="$msg verified pre-update backup: $verified_backup;"
  elif [ -n "$incomplete_backup" ]; then
    msg="$msg NO verified backup; $incomplete_backup is incomplete and must not be used as a restore point;"
  else
    msg="$msg no backup was created;"
  fi
  msg="$msg workspace $home was not moved or restored; restart manually after fixing the cause"
  say "$msg"
  printf '%s\n' "$msg" >&2
  exit "$rc"
}
trap cleanup EXIT
# A signal is a failure: cleanup stops a started candidate and reports the state.
trap 'exit 130' HUP INT TERM

# One run at a time; a second invocation is a no-op, never a concurrent writer.
(umask 077; : >"$state/lock") 2>/dev/null || {
  echo "repairflow-autoupdate: cannot create $state/lock" >&2; exit 1; }
exec 9<>"$state/lock"
flock -n 9 || exit 0

# Bounded, validated before the stop so a bad value cannot abort mid-update.
tries=${RF_UPDATE_TRIES:-15}
case $tries in ''|*[!0-9]*) refuse "RF_UPDATE_TRIES must be a positive integer, got '$tries'";; esac
[ "$tries" -ge 1 ] && [ "$tries" -le 600 ] ||
  refuse "RF_UPDATE_TRIES must be between 1 and 600, got '$tries'"

# Never update a workspace that is not healthy.
"$bin" --home "$home" doctor >/dev/null || { say "skip: workspace unhealthy"; exit 0; }

# The channel is GitHub's "latest": one HEAD request, no API, no token, no jq.
if [ -n "${RF_UPDATE_TAG:-}" ]; then
  cand=$RF_UPDATE_TAG
else
  latest=$(curl -fsSI -m 15 https://github.com/obionar/repairflow/releases/latest 2>/dev/null) || latest=
  cand=$(printf '%s\n' "$latest" | tr -d '\r' |
         sed -n 's|^[Ll]ocation: .*/tag/\(v[^ /]*\)$|\1|p')
  [ -n "$cand" ] || { say "skip: cannot resolve latest release"; exit 0; }
fi
# The tag becomes a file name below, so accept only the release-tag grammar.
case $cand in *[!0-9A-Za-z.+-]*) refuse "unexpected candidate tag '$cand'";; esac
check=$("$fetch" "$cand" 2>&1) || { say "skip: $cand not installable here"; exit 0; }
say "check: $check"
case $check in *"up to date"*) say "noop: up to date"; exit 0;; esac
if [ -f "$state/failed-$cand" ]; then say "skip: $cand already failed"; exit 0; fi

# Read the effective listener from the trusted installed binary; never re-parse TOML.
cfg=$("$bin" config check --home "$home" --json 2>/dev/null) ||
  refuse "cannot read the effective configuration; update manually"
host=$(printf '%s\n' "$cfg" | sed -n 's/.*"Web":{"Host":"\([^"]*\)".*/\1/p' | head -n 1)
port=$(printf '%s\n' "$cfg" | sed -n 's/.*"Web":{"Host":"[^"]*","Port":\([0-9]*\).*/\1/p' | head -n 1)
case $host in ''|*[!0-9A-Za-z.:_-]*) refuse "ambiguous web.host '$host' in the effective configuration";; esac
case $port in ''|*[!0-9]*) refuse "ambiguous web.port '$port' in the effective configuration";; esac
[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || refuse "web.port $port is out of range"
case $host in
  0.0.0.0|'*') host=127.0.0.1;;
  ::|'[::]') host='[::1]';;
esac
case $host in *:*) case $host in \[*\]) ;; *) host="[$host]";; esac;; esac
base=http://$host:$port

# Record counts prove the candidate did not lose data.
pre=$("$bin" --home "$home" --json customer list --per-page 1 2>/dev/null) ||
  refuse "cannot read record counts before the update; update manually"
before=$(printf '%s\n' "$pre" | sed -n 's/.*"total":\([0-9]*\).*/\1/p' | head -n 1)
[ -n "$before" ] || refuse "cannot parse the record count before the update; update manually"

# Resolve the one service this workspace is installed as, before changing anything.
# Unsupported layouts are refused instead of guessed at, and there is no fallback
# from the detected supervisor to another one.
initd=${REPAIRFLOW_INITD:-/etc/init.d}
unquote() { v=$1; case $v in \"*\") v=${v#\"}; v=${v%\"};; esac; printf '%s' "$v"; }
if command -v systemctl >/dev/null 2>&1; then
  init=systemd
  # The unit systemd actually loaded is the only authority: a stale file at the
  # guessed default path or a different XDG config root must not decide this.
  fragment=$(systemctl --user show --property=FragmentPath --value repairflow.service 9>&- 2>/dev/null) || fragment=
  reload=$(systemctl --user show --property=NeedDaemonReload --value repairflow.service 9>&- 2>/dev/null) || reload=
  [ -n "$fragment" ] ||
    refuse "cannot read the effective systemd unit path for repairflow.service; run 'systemctl --user daemon-reload' or update manually"
  case $fragment in /*) ;; *) refuse "systemd FragmentPath '$fragment' is not absolute; update manually";; esac
  [ -f "$fragment" ] || refuse "effective systemd unit $fragment is missing; update manually"
  [ "$reload" = no ] ||
    refuse "repairflow.service has NeedDaemonReload='$reload'; run 'systemctl --user daemon-reload', then retry"
  n_exec=$(sed -n 's/^ExecStart=//p' "$fragment" | wc -l | tr -d ' ')
  [ "$n_exec" = 1 ] ||
    refuse "unsupported unit $fragment: expected exactly one ExecStart, found $n_exec; update manually"
  exec_line=$(sed -n 's/^ExecStart=//p' "$fragment")
  workdir=$(unquote "$(sed -n 's/^WorkingDirectory=//p' "$fragment" | head -n 1)")
  case $exec_line in
    "$bin serve --home $home"|"\"$bin\" serve --home \"$home\"") ;;
    *) refuse "unit $fragment ExecStart does not pin '$bin serve --home $home'; update manually";;
  esac
  [ "$workdir" = "$home" ] || refuse "unit $fragment WorkingDirectory is '$workdir', not '$home'; update manually"
  priv=
  say "service: systemd user unit $fragment"
elif [ -f "$initd/repairflow" ]; then
  init=openrc
  unit_bin=$(unquote "$(sed -n 's/^command=//p' "$initd/repairflow" | head -n 1)")
  unit_args=$(unquote "$(sed -n 's/^command_args=//p' "$initd/repairflow" | head -n 1)")
  [ "$unit_bin" = "$bin" ] || refuse "OpenRC script runs '$unit_bin', not '$bin'; update manually"
  [ "$unit_args" = "serve --home $home" ] || refuse "OpenRC script serves '$unit_args', not --home $home; update manually"
  if [ "$(id -u)" = 0 ]; then
    priv=
  elif command -v doas >/dev/null 2>&1; then
    priv=doas
  elif command -v sudo >/dev/null 2>&1; then
    priv=sudo
  else
    refuse "cannot stop/start the OpenRC service without root, doas or sudo; update manually"
  fi
  say "service: OpenRC script $initd/repairflow"
else
  refuse "no repairflow service found (effective systemd user unit or $initd/repairflow); update manually"
fi

svc() {
  # fd 9 is the updater lock: never let a service command pass it to the daemon.
  if [ "$init" = systemd ]; then systemctl --user "$@" repairflow.service 9>&-; else
    if [ -n "$priv" ]; then "$priv" -n rc-service repairflow "$@" 9>&-; else rc-service repairflow "$@" 9>&-; fi
  fi
}
# Every service command's outcome is logged; a broken log must not hide it.
svc_log() {
  if out=$(svc "$@" 2>&1); then
    [ -n "$out" ] && say "$init $*: $out"
    return 0
  fi
  say "$init $* failed: $out"
  return 1
}
# A tool's own output is logged only when it fails; it may contain diagnostics
# (paths, SQLite state) but never customer payloads or credentials.
run_log() {
  if out=$("$@" 2>&1); then
    say "ok: $*"
    return 0
  fi
  say "failed: $*: $out"
  return 1
}
service_state() {
  if [ "$init" = systemd ]; then
    out=$(systemctl --user is-active repairflow.service 9>&- 2>/dev/null) || true
    case $out in active|activating) echo running;; inactive|failed) echo stopped;; *) echo unknown;; esac
  else
    if out=$(svc status 2>&1); then echo running; else
      case $out in *"status: stopped"*) echo stopped;; *) echo unknown;; esac
    fi
  fi
}
# Readiness needs curl -f; liveness must treat any HTTP status as occupied.
probe() { curl -fsS -m 5 -o /dev/null "$base/$1" >/dev/null 2>&1; }
# Any HTTP response means a listener remains. Only a definite connection refusal
# proves the port is free; a timeout or other transport error is ambiguous and
# must prevent the swap rather than be read as quiescence.
listener_state() {
  if code=$(curl -sS -m 5 -o /dev/null -w '%{http_code}' "$base/$1" 2>/dev/null); then
    case $code in
      [1-5][0-9][0-9]) echo occupied;;
      *) echo ambiguous;;
    esac
  else
    rc=$?
    if [ "$rc" = 7 ]; then echo free; else echo ambiguous; fi
  fi
}
# A failed candidate is stopped and marked; nothing is restored or renamed.
reject_candidate() { mark_failed; fail "$*"; }

# Restore-point space is checked on the filesystem that will actually hold it,
# and the unique directory is created before the stop so an unusable destination
# can never cost the running service.
mkdir -p "$HOME/backups" 2>/dev/null ||
  refuse "cannot create the backup directory $HOME/backups; update manually"
used=$(du -sk "$home" 2>/dev/null | cut -f1)
case $used in ''|*[!0-9]*) refuse "cannot size workspace $home";; esac
need=$(( used * 3 + 200000 ))
stamp=$(date +%Y%m%dT%H%M%S)
bdir=$(mktemp -d "$HOME/backups/pre-$cand-$stamp.XXXXXX") 2>/dev/null ||
  refuse "cannot create a unique backup directory under $HOME/backups; update manually"
incomplete_backup=$bdir
avail=$(df -Pk "$bdir" 2>/dev/null | awk 'NR==2{print $4}')
case $avail in ''|*[!0-9]*) refuse "cannot determine free space on $HOME/backups; update manually";; esac
[ "$avail" -gt "$need" ] || refuse "only ${avail}K free on $HOME/backups, need ${need}K"
bkp=$bdir/repairflow.rfbak

# Stop the intended service before the binary swap, so no old process keeps the
# database open and no candidate migrates it behind a live server.
say "apply: $cand (stopping $init repairflow first)"
svc_touched=1
svc_log stop || fail "cannot stop $init repairflow; nothing was applied and the workspace is untouched"
after_state=$(service_state)
[ "$after_state" = stopped ] ||
  fail "service state is '$after_state' after stop; refusing to swap the binary (nothing was applied)"
listen=$(listener_state login) || listen=ambiguous
case $listen in
  free) ;;
  occupied) fail "$base/login still answers after stop; refusing to swap the binary (the listener was left alone)";;
  *) fail "cannot establish that $base/login is quiescent after stop (ambiguous transport error); refusing to swap the binary";;
esac

# The restore point, verified, outside the workspace. Nothing proceeds without it;
# the schema is forward-only, so the previous binary alone cannot undo a migration.
if ! run_log "$bin" --home "$home" backup create --output "$bkp"; then
  fail "pre-update backup creation failed; nothing was applied; incomplete result kept at $bkp"
fi
if ! run_log "$bin" backup verify "$bkp"; then
  fail "pre-update backup verification failed; nothing was applied; unverified result kept at $bkp"
fi
verified_backup=$bkp
incomplete_backup=

# Apply. The binary verifies signature, hash and platform, refuses a same-version or
# older candidate, and keeps <exe>.prev.
apply_attempted=1
if ! run_log "$fetch" "$cand" --apply; then
  fail "$cand was not applied (refused or failed); the previous binary, the workspace and $bkp are intact"
fi
candidate_applied=1

# The candidate's own identity is the expected health target.
vjson=$("$bin" version --json 2>/dev/null) ||
  reject_candidate "cannot read the installed version after apply"
want_version=$(printf '%s\n' "$vjson" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p' | head -n 1)
want_commit=$(printf '%s\n' "$vjson" | sed -n 's/.*"commit":"\([^"]*\)".*/\1/p' | head -n 1)
[ -n "$want_version" ] && [ -n "$want_commit" ] ||
  reject_candidate "cannot parse the installed version after apply"
[ "v$want_version" = "$cand" ] ||
  reject_candidate "applied candidate is $cand but the binary reports version $want_version"

svc_log start || reject_candidate "$init repairflow did not start the $cand candidate"
after_state=$(service_state)
[ "$after_state" = running ] ||
  reject_candidate "service state is '$after_state' after starting $cand"

# Only the exact value of the stable identity fields counts; a version-like
# substring elsewhere on the page, a prefix or an ambiguous duplicate does not.
check_about() {
  page=$(curl -fsS -m 5 "$base/about" 2>/dev/null) || return 1
  fields=$(printf '%s\n' "$page" | tr '<' '\n')
  [ "$(printf '%s\n' "$fields" | sed -n 's/^dd id="about-version">.*/x/p' | wc -l | tr -d ' ')" = 1 ] || return 1
  [ "$(printf '%s\n' "$fields" | sed -n 's/^dd id="about-commit">.*/x/p' | wc -l | tr -d ' ')" = 1 ] || return 1
  page_version=$(printf '%s\n' "$fields" | sed -n 's/^dd id="about-version">\([^<>]*\)$/\1/p')
  page_commit=$(printf '%s\n' "$fields" | sed -n 's/^dd id="about-commit">\([^<>]*\)$/\1/p')
  [ "$page_version" = "$want_version" ] || return 1
  [ "$page_commit" = "$want_commit" ] || return 1
}

# The health check is the verdict: the configured endpoint, the exact identity on
# /about, the candidate's doctor and the record count all have to agree. Bounded
# retries cover startup.
n=0
healthy=0
while [ "$n" -lt "$tries" ]; do
  n=$((n + 1))
  if probe login && check_about; then
    healthy=1
    break
  fi
  if [ "$n" -lt "$tries" ]; then sleep 2; fi
done
[ "$healthy" = 1 ] ||
  reject_candidate "$cand does not serve version $want_version commit $want_commit at $base/about"

# The installed candidate must pass its own doctor after the restart, before success.
run_log "$bin" --home "$home" doctor ||
  reject_candidate "candidate $cand was installed but doctor reports an unhealthy workspace"

post=
if ! post=$("$bin" --home "$home" --json customer list --per-page 1 2>/dev/null); then
  reject_candidate "cannot read record counts from the $cand candidate"
fi
after=$(printf '%s\n' "$post" | sed -n 's/.*"total":\([0-9]*\).*/\1/p' | head -n 1)
[ "$after" = "$before" ] ||
  reject_candidate "record count changed ${before}->${after:-?} under $cand"

finished=1
say "ok: $cand installed and healthy (version $want_version, commit $want_commit, $base, $after customers); backup kept at $bkp; no backups were deleted"
exit 0
